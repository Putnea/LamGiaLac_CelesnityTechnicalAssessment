# ── Application Database (main app) ──
APP_DB_HOST=app-db
APP_DB_PORT=5434
APP_DB_USERNAME=celesnity
APP_DB_PASSWORD=celesnity_secret
APP_DB_DATABASE=celesnity_app

# ── Fixture Production Database (simulates external source) ──
FIXTURE_DB_HOST=fixture-db
FIXTURE_DB_PORT=5433
FIXTURE_DB_USERNAME=factory
FIXTURE_DB_PASSWORD=factory_secret
FIXTURE_DB_DATABASE=factory_production

# ── Fixture API ──
FIXTURE_API_URL=http://fixture-api:3001

# ── Fixture Supplier Site ──
FIXTURE_SUPPLIER_URL=http://fixture-supplier:3002

# ── MQTT (Optional) ──
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_ENABLED=false

# ── Backend ──
BACKEND_PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3003

# ── Security ──
# REQUIRED: Set to a strong random string (32+ chars) before starting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Never commit the real value to source control.
ENCRYPTION_KEY=change_me_to_a_random_32_plus_char_string

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ── Staleness ──
STALE_THRESHOLD_MINUTES=15

